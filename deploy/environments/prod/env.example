# Production Environment Configuration
# Copy this file to .env and update with your actual production values
# SECURITY WARNING: Never commit .env file to version control!

# Server Configuration
PORT=8080
ENV=production
FRONTEND_URL=http://15.235.202.148:3000
ALLOWED_ORIGINS=http://15.235.202.148:3000,http://15.235.202.148:8080

# Database Configuration (Supabase)
SUPABASE_URL=your_production_supabase_url_here
SUPABASE_ANON_KEY=your_production_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key_here

# Redis Configuration
REDIS_URL=redis:6379
REDIS_DB=0
REDIS_USE_TLS=false
CACHE_ENABLED=true

# OAuth Configuration
GOOGLE_CLIENT_ID=your_production_google_client_id_here
GOOGLE_CLIENT_SECRET=your_production_google_client_secret_here
GOOGLE_REDIRECT_URL=http://15.235.202.148:8080/api/v1/auth/google/callback

# Session Configuration
SESSION_MAX_AGE=86400
SESSION_SECRET=your_production_session_secret_here

# Logging Configuration
LOG_LEVEL=info
DEBUG=false

# Production specific
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://15.235.202.148:8080/api/v1
NEXT_PUBLIC_GRAPHQL_URL=http://15.235.202.148:8080/api/v1/graphql

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_TRACING=false

# Security Configuration
CORS_ALLOWED_ORIGINS=http://15.235.202.148:3000,http://15.235.202.148:8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
