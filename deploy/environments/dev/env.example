# Development Environment Configuration
# Copy from backend/.env and customize for development
# SECURITY WARNING: Never commit .env file to version control!

# Server Configuration
PORT=8080
ENV=development
FRONTEND_URL=https://spark-park-dev.dojima.foundation
ALLOWED_ORIGINS=https://spark-park-dev.dojima.foundation,http://139.99.73.135:3000,http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_SCHEMA=dev_v1

# Redis Configuration
REDIS_URL=redis:6379
REDIS_DB=1
REDIS_USE_TLS=false
CACHE_ENABLED=true

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=https://spark-park-dev.dojima.foundation/api/v1/auth/google/callback

# Session Configuration
SESSION_MAX_AGE=86400
SESSION_SECRET=generate_secure_random_secret_here_64_characters_minimum

# Logging Configuration
LOG_LEVEL=debug
DEBUG=true

# Monitoring Configuration
PROMETHEUS_URL=http://139.99.73.135:9090
GRAFANA_URL=http://139.99.73.135:3002
ENVIRONMENT=dev

# Development specific
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://spark-park-dev.dojima.foundation/api/v1
NEXT_PUBLIC_GRAPHQL_URL=https://spark-park-dev.dojima.foundation/api/v1/graphql
