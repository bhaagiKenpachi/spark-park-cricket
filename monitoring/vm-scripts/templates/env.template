# Environment Configuration Template
# Copy this file to .env and customize for your environment

# Environment Settings
ENVIRONMENT=dev
CLUSTER_NAME=cricket-cluster
ENVIRONMENT_DOMAIN=localhost

# Application Settings
BACKEND_HOST=localhost
BACKEND_PORT=8080
WEB_HOST=localhost
WEB_PORT=3000
CUSTOM_METRICS_HOST=localhost
CUSTOM_METRICS_PORT=9091

# Database Settings
POSTGRES_EXPORTER_HOST=localhost
POSTGRES_EXPORTER_PORT=9187

# Redis Settings
REDIS_EXPORTER_HOST=localhost
REDIS_EXPORTER_PORT=9121

# Grafana Settings
GRAFANA_ADMIN_PASSWORD=admin123
GRAFANA_API_KEY=

# Alerting Settings
ALERT_FROM_EMAIL=alerts@cricket.local
CRITICAL_ALERT_EMAIL=admin@cricket.local
WARNING_ALERT_EMAIL=alerts@cricket.local
ALERT_REPEAT_INTERVAL=1h

# SMTP Settings (for email alerts)
SMTP_HOST=localhost:587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# Webhook Settings (for custom integrations)
WEBHOOK_URL=http://localhost:5001/webhook
CRITICAL_WEBHOOK_URL=http://localhost:5001/critical
WARNING_WEBHOOK_URL=http://localhost:5001/warning
ERROR_WEBHOOK_URL=http://localhost:5001/errors

# Production Environment Override Examples:
# ENVIRONMENT=prod
# ENVIRONMENT_DOMAIN=cricket.example.com
# GRAFANA_ADMIN_PASSWORD=secure_password_here
# CRITICAL_ALERT_EMAIL=admin@example.com
# SMTP_HOST=smtp.example.com:587
# SMTP_USERNAME=alerts@example.com
# SMTP_PASSWORD=secure_smtp_password
